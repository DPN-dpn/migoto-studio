# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.dds binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
